/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests for Plant Mode
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/funcscan -profile test_plant_mode,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h',
    ]
}

params {
    config_profile_name        = 'Plant Mode test profile'
    config_profile_description = 'Minimal test dataset to check Plant Mode workflow function'

    // Input data
    input = "${projectDir}/tests/samplesheet_plant.csv"
    
    // Plant Mode settings
    plant_mode                 = true
    busco_threshold            = 0.0 // Disable filtering for test with non-plant data
    run_amp_screening          = true // Enabled: x86 environment supports AMPIR and AMPlify
    amp_skip_amplify           = false // Enabled: No longer on slow ARM emulation
    plantismash_knownclusterblast = false // Disable to avoid missing DB error in test container
    plantismash_subgroup         = false // Disable: container image lacks subgroup reference alignments
    run_bigscape                 = false // Disable: BiG-SCAPE failing on empty inputs or config issues
    wave.enabled                 = false // Disable: Wave service failing DNS lookup on WSL
}
